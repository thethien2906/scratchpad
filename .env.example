# Host interface and HTTP port (default 127.0.0.1 so traffic goes through reverse proxy)
BIND_HOST=127.0.0.1
PORT=8080

# SQLite database path inside the container
DATABASE_PATH=/app/data/erwining.db

# Set true only when requests reach the app through an HTTPS reverse proxy.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Required to create profiles from the hidden developer console.
ADMIN_SECRET=create_profile

# Used by direct `docker compose up`; deploy.sh overrides these with the
# owner of ./data so SQLite can write to the bind-mounted directory.
APP_UID=1000
APP_GID=1000
